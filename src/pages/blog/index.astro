---
import Base from "../../layouts/Base.astro";
import { Nav } from "../../sections/Nav";
import { Footer } from "../../sections/Footer";
import PostCard from "../../components/blog/PostCard.astro";
import SampleCta from "../../components/blog/SampleCta.astro";
import { getPosts, postPath } from "../../lib/blog";
import { absolute, breadcrumbs, graph, organization } from "../../lib/seo";

const posts = await getPosts();
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p !== featured);

const jsonLd = graph(
  organization,
  {
    "@type": "Blog",
    "@id": absolute("/blog/#blog"),
    name: "The VietCaPhe blog",
    url: absolute("/blog/"),
    description: "Guides, ideas and market notes on specialty robusta for Australian roasters and green coffee buyers.",
    publisher: { "@id": organization["@id"] },
    inLanguage: "en-AU",
    blogPost: posts.map((p) => ({
      "@type": "BlogPosting",
      headline: p.data.title,
      url: absolute(postPath(p)),
      datePublished: p.data.pubDate.toISOString(),
    })),
  },
  breadcrumbs([
    { name: "Home", path: "/" },
    { name: "Blog", path: "/blog/" },
  ]),
);
---

<Base
  title="Blog | Specialty robusta for roasters | VietCaPhe"
  description="Guides, product ideas and market notes on specialty robusta for Australian roasters and green coffee buyers, from the team at VietCaPhe."
  path="/blog/"
  jsonLd={jsonLd}
  themeColor="#f6eee2"
>
  <Nav client:load />
  <main>
    <section class="bg-cream pb-20 pt-32 sm:pt-40">
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <p class="font-display text-lg font-bold text-orange">The VietCaPhe blog</p>
        <h1 class="mt-3 max-w-4xl font-display text-[clamp(3rem,8vw,7rem)] font-extrabold leading-[0.9] tracking-[-0.045em]">
          Notes for <span class="inline-block -rotate-1 rounded-[0.18em] bg-ink px-[0.14em] text-yellow">roasters.</span>
        </h1>
        <p class="mt-7 max-w-2xl text-lg leading-relaxed text-ink/70 sm:text-xl">
          Practical guides to roasting, blending and selling specialty robusta, plus product ideas and market notes for
          Australian roasters and green buyers.
        </p>

        {featured && <div class="mt-16 sm:mt-20"><PostCard post={featured} large /></div>}

        {
          rest.length > 0 && (
            <div class="mt-20 grid gap-x-8 gap-y-14 border-t-2 border-ink pt-14 sm:grid-cols-2 lg:grid-cols-3">
              {rest.map((p) => (
                <PostCard post={p} />
              ))}
            </div>
          )
        }
      </div>
    </section>
    <SampleCta />
  </main>
  <Footer client:visible />
</Base>
