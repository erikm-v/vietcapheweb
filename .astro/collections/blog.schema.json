{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 80
    },
    "seoTitle": {
      "type": "string",
      "maxLength": 60
    },
    "description": {
      "type": "string",
      "minLength": 80,
      "maxLength": 160
    },
    "pubDate": {
      "type": "string",
      "format": "date-time"
    },
    "updatedDate": {
      "type": "string",
      "format": "date-time"
    },
    "category": {
      "type": "string",
      "enum": [
        "Robusta education",
        "Roaster playbook",
        "Product ideas",
        "Market & sourcing",
        "Demand & trends",
        "Origin & sustainability",
        "Case study"
      ]
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cover": {
      "type": "string"
    },
    "coverAlt": {
      "type": "string"
    },
    "coverTheme": {
      "default": "orange",
      "type": "string",
      "enum": [
        "orange",
        "ink",
        "yellow",
        "cream"
      ]
    },
    "takeaways": {
      "minItems": 3,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "faq": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string"
          },
          "a": {
            "type": "string"
          }
        },
        "required": [
          "q",
          "a"
        ]
      }
    },
    "sources": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "title",
          "publisher",
          "url"
        ]
      }
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "pubDate",
    "category",
    "takeaways"
  ]
}